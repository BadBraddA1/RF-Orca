# Turso (required for durable multi-device shows)
TURSO_DATABASE_URL=libsql://rf-orca-braddford.aws-us-east-2.turso.io
TURSO_AUTH_TOKEN=

# Optional canonical URL (PUBLIC_ preferred; NEXT_PUBLIC_ still accepted)
PUBLIC_SITE_URL=https://rforca.com
NEXT_PUBLIC_SITE_URL=https://rforca.com

# Ably app "RF Orca" — server key only (browser uses /api/ably-auth tokens)
ABLY_API_KEY=

# Sentry (project rf-orca)
PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=braddcorp
SENTRY_PROJECT=rf-orca

# PostHog — client registers product: rf-orca
PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://n.braddcorp.com
NEXT_PUBLIC_POSTHOG_HOST=https://n.braddcorp.com
PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
